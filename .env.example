# ════════════════════════════════════════════════════════════════
#  Smart CAUTI GUARD — ตัวแปรสภาพแวดล้อม
#  คัดลอกไฟล์นี้เป็น .env.local แล้วกรอกค่าจริง
#  ห้าม commit .env.local เข้า git
# ════════════════════════════════════════════════════════════════

# ── Supabase ───────────────────────────────────────────────────
# หาได้จาก Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# service_role key — มีสิทธิ์เต็ม ใช้ฝั่ง server เท่านั้น
# ห้ามขึ้นต้นด้วย NEXT_PUBLIC_ เด็ดขาด เพราะจะถูกส่งไปที่เบราว์เซอร์
SUPABASE_SERVICE_ROLE_KEY=

# ── ความปลอดภัย ────────────────────────────────────────────────
# สร้างด้วย:  openssl rand -base64 48
# ใช้เซ็น JWT ของ session — ต้องยาวอย่างน้อย 32 อักขระ
SESSION_SECRET=

# ใช้เซ็น HMAC ของรหัสป้าย QR — ต้องยาวอย่างน้อย 32 อักขระ
# เปลี่ยนค่านี้เมื่อใดก็ตาม ป้ายที่พิมพ์ไปแล้วทั้งหมดจะใช้ไม่ได้
QR_SECRET=

# ── URL ของระบบ ────────────────────────────────────────────────
# ใช้สร้าง URL ที่พิมพ์ลงป้าย QR
NEXT_PUBLIC_BASE_URL=http://localhost:3000
